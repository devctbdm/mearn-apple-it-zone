# ==========================================
# Application
# ==========================================
NODE_ENV=production
PORT=5000


# ==========================================
# MongoDB
# ==========================================
DB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/<DATABASE_NAME>


# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_strong_random_jwt_secret


# ==========================================
# Frontend / Backend URLs
# ==========================================
# Production frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# Production backend URL
BACKEND_URL=https://your-backend-domain.com


# ==========================================
# Trust Proxy
# ==========================================
# Render / Railway / similar platforms:
# Usually 1 is appropriate when the app is behind one proxy.
TRUST_PROXY=1


# ==========================================
# CORS
# ==========================================
# Comma-separated allowed frontend origins.
# Example:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com


# ==========================================
# Redis
# ==========================================
REDIS_ENABLED=true
REDIS_TLS=true
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# Default cache TTL in seconds
REDIS_TTL=300


# ==========================================
# Resend Email
# ==========================================
RESEND_API_KEY=your_resend_api_key

# After verifying your domain:
# Example:
# RESEND_FROM=Apple IT Zone <no-reply@yourdomain.com>
RESEND_FROM=Apple IT Zone <no-reply@yourdomain.com>

EMAIL_ENABLED=true